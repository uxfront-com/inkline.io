{
    "name": "inkline-v3",
    "compatibility_date": "2026-11-01",
    // Static site produced by `vite-ssg build`. Unknown paths fall back to
    // index.html, like the old Netlify `/* -> /index.html` rewrite.
    "assets": {
        "directory": "dist",
        "not_found_handling": "single-page-application"
    }
}
